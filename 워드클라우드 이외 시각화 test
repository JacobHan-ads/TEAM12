import streamlit as st
import pandas as pd
import matplotlib.pyplot as plt
import platform
import re
from wordcloud import WordCloud
from collections import Counter
import plotly.express as px  # 트리맵 및 고도화 시각화를 위한 라이브러리 추가


def set_matplotlib_font():
    """
    운영체제별로 Matplotlib 한글 폰트를 설정하는 함수
    """
    os_name = platform.system()
    if os_name == "Windows":
        plt.rc("font", family="Malgun Gothic")
    elif os_name == "Darwin":  # Mac
        plt.rc("font", family="AppleGothic")
    else:
        plt.rc("font", family="NanumGothic")
    plt.rc("axes", unicode_minus=False)


def load_and_preprocess_data(uploaded_file):
    """
    업로드된 CSV 파일을 읽어와 전처리하는 함수
    """
    try:
        df = pd.read_csv(uploaded_file, encoding="utf-8-sig")
        required_columns = ["제품명", "카테고리", "작성일자", "평점", "리뷰내용"]
        if not all(col in df.columns for col in required_columns):
            st.error("업로드된 파일의 컬럼 구조가 올바르지 않습니다. 필수 컬럼을 확인하세요.")
            return None

        df = df.dropna(subset=["리뷰내용", "평점"])
        df["평점"] = df["평점"].astype(int)
        return df
    except Exception as e:
        st.error(f"파일을 로드하는 중 오류가 발생했습니다: {e}")
        return None


def filter_data(df):
    """
    사이드바 필터를 생성하고 데이터를 필터링하는 함수
    """
    st.sidebar.header("데이터 필터 설정")
    categories = sorted(df["카테고리"].unique())
    selected_categories = st.sidebar.multiselect("가전 카테고리 선택", categories, default=categories)

    filtered_df_by_cat = df[df["카테고리"].isin(selected_categories)]
    products = sorted(filtered_df_by_cat["제품명"].unique())

    selected_products = st.sidebar.multiselect("특정 제품명 선택", products, default=products)
    final_df = filtered_df_by_cat[filtered_df_by_cat["제품명"].isin(selected_products)]
    return final_df


def visualize_rating_distribution(df):
    """
    제품별 평점 분포를 막대 그래프로 시각화하는 함수
    """
    st.subheader("제품별 평점 분포")
    rating_counts = df["평점"].value_counts().reindex(range(1, 6), fill_value=0)

    fig, ax = plt.subplots(figsize=(8, 3))
    ax.bar(rating_counts.index, rating_counts.values, color="skyblue", edgecolor="black")
    ax.set_xlabel("평점")
    ax.set_ylabel("리뷰 수")
    ax.set_title("선택된 제품의 평점 분포 (1점 ~ 5점)")
    ax.set_xticks(range(1, 6))

    st.pyplot(fig)
    plt.close(fig)


def analyze_complaint_keywords(negative_df):
    """
    부정 리뷰 내용을 분석하여 불만 유형별 빈도를 계산하고 키워드 사전용 텍스트를 반환하는 함수
    """
    hw_keywords = ["소음", "배터리", "진동", "발열", "불량", "결함", "유격", "마감"]
    sw_keywords = ["어플", "연동", "조작", "인터페이스", "UI", "기능", "버튼", "터치"]

    hw_count = 0
    sw_count = 0
    all_words = []

    # [수정/강화] 불필요한 문법, 조사 대용어, 가전 관련 범용 단어 전면 차단 (불용어 사전 강화)
    stopwords = {
        "리뷰", "너무", "진짜", "정말", "아주", "많이", "조금", "약간", "제품", "물건",
        "구매", "기기", "가전", "사용", "해서", "사서", "보니", "하고", "있고", "같아요",
        "합니다", "안됨", "안되네요", "되요", "그냥", "하나", "사람", "이다", "와서",
        "완전", "별로", "다시", "처음", "지금", "가지고", "같음", "이거", "그거"
    }

    for review in negative_df["리뷰내용"]:
        review_str = str(review)

        if any(hw_word in review_str for hw_word in hw_keywords):
            hw_count += 1
        if any(sw_word in review_str for sw_word in sw_keywords):
            sw_count += 1

        clean_review = re.sub(r"[^가-힣\s]", "", review_str)

        for word in clean_review.split():
            # 의미 없는 단어 및 조사 탈락용 조건 강화
            if len(word) >= 2 and word not in stopwords:
                all_words.append(word)

    complaint_counts = {"하드웨어 결함 요인": hw_count, "소프트웨어/사용 편의성 요인": sw_count}
    return complaint_counts, all_words


def visualize_complaints(complaint_counts, all_words, negative_df):
    """
    개선된 분석 결과를 시각화하는 함수 (트리맵 및 상위 키워드 분석 추가)
    """
    st.subheader("소비자 불만 여론 심층 분석")

    # 탭 메뉴를 통해 깔끔하게 결과 분리
    tab1, tab2 = st.tabs(["📊 불만 요인 & 키워드 상세", "🗺️ 카테고리별 불만 분포 (트리맵)"])

    with tab1:
        col1, col2 = st.columns(2)
        with col1:
            st.write("**불만 유형 분류 차트**")
            fig, ax = plt.subplots(figsize=(6, 5))
            ax.bar(complaint_counts.keys(), complaint_counts.values(), color=["salmon", "orange"], edgecolor="black")
            ax.set_ylabel("관련 불만 리뷰 수")
            ax.set_title("하드웨어 결함 vs 소프트웨어 편의성 빈도 비교")
            st.pyplot(fig)
            plt.close(fig)

        with col2:
            st.write("**핵심 불만 키워드 Top 15 (가로 막대)**")
            if all_words:
                word_counts = Counter(all_words)
                # 상위 15개만 추출하여 데이터프레임화
                top_words = pd.DataFrame(word_counts.most_common(15), columns=["단어", "빈도"])

                # Plotly를 이용한 깔끔한 가로 막대 그래프 (워드클라우드 대안)
                fig_bar = px.bar(
                    top_words, x="빈도", y="단어", orientation="h",
                    color="빈도", color_continuous_scale="Reds",
                    labels={"빈도": "단어 출현 횟수"}
                )
                fig_bar.update_layout(yaxis={"categoryorder": "total ascending"}, height=380,
                                      margin=dict(t=20, b=20, l=20, r=20))
                st.plotly_chart(fig_bar, use_container_width=True)
            else:
                st.write("분석할 단어가 부족합니다.")

    with tab2:
        st.write("**어느 카테고리/제품에서 부정 리뷰(1~3점)가 많을까?**")
        if not negative_df.empty:
            # 카테고리와 제품명별로 부정 리뷰 수 집계
            treemap_data = negative_df.groupby(["카테고리", "제품명"]).size().reset_index(name="부정리뷰수")

            # 인터랙티브 트리맵 그리기
            fig_tree = px.treemap(
                treemap_data,
                path=["카테고리", "제품명"],
                values="부정리뷰수",
                color="부정리뷰수",
                color_continuous_scale="OrRd",
                title="부정 리뷰 계층 분포"
            )
            fig_tree.update_layout(height=450)
            st.plotly_chart(fig_tree, use_container_width=True)
        else:
            st.write("분포를 표현할 부정 리뷰 데이터가 없습니다.")


def main():
    st.set_page_config(layout="wide")
    st.title("가전 제품 통합 리뷰 불만 분석 대시보드")
    st.write("TEAM 12 (키워드 사냥꾼) - 한예호, 김민재")
    st.write("---")

    set_matplotlib_font()

    uploaded_file = st.file_uploader(
        "all_appliances_reviews.csv 파일을 업로드하세요.",
        type=["csv"],
        key="app_review_uploader_unique_key"
    )

    if uploaded_file is not None:
        df = load_and_preprocess_data(uploaded_file)

        if df is not None:
            filtered_df = filter_data(df)

            if filtered_df.empty:
                st.warning("선택 조건에 부합하는 데이터가 존재하지 않습니다. 필터를 다시 조정해 주세요.")
                return

            st.subheader("필터링된 데이터 리스트")
            st.dataframe(filtered_df, use_container_width=True, hide_index=True)

            st.write("---")
            visualize_rating_distribution(filtered_df)

            st.write("---")
            negative_df = filtered_df[filtered_df["평점"] <= 3]

            if not negative_df.empty:
                complaint_counts, all_words = analyze_complaint_keywords(negative_df)
                # 시각화 함수로 negative_df도 함께 넘겨 트리맵을 그리도록 수정
                visualize_complaints(complaint_counts, all_words, negative_df)
            else:
                st.info("평점 1~3점 대의 부정적인 리뷰 데이터가 존재하지 않아 불만 키워드 분석을 생략합니다.")
    else:
        st.info("분석을 시작하려면 상단의 파일 업로더 영역에 CSV 파일을 드래그하거나 선택하여 업로드해 주세요.")


if __name__ == "__main__":
    main()
